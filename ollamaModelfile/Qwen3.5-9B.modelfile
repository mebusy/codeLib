# ============================================================
# Qwen3.5-9B 4bit - Game Development Assistant
# Base: Ollama qwen3.5:9b
# Target: Apple Silicon M4 Pro 24GB
# ============================================================

FROM qwen3.5:9b

# ------------------------------------------------------------
# Runtime parameters
# ------------------------------------------------------------

# 128K content
PARAMETER num_ctx 65536

# Allow reasonably long code and technical explanations
PARAMETER num_predict 4096

# Lower temperature for reliable coding and debugging
PARAMETER temperature 0.35

PARAMETER top_p 0.9
PARAMETER top_k 30
PARAMETER repeat_penalty 1.05

